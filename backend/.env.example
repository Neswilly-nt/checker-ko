# Local development. Never put real credentials in this file.
APP_ENV=development
DATABASE_URL=sqlite:///./private_data/checker.db
CHECKER_DATA_DIR=./private_data
CHECKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHECKER_STORAGE_BACKEND=local
LOG_LEVEL=INFO
PHASH_THRESHOLD=12
VIDEO_MAX_MB=50
VIDEO_MAX_SECONDS=30

# Production example (set through the host secret manager, not this file):
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://checker:REPLACE_ME@db.internal:5432/checker?sslmode=require
# CHECKER_DATA_DIR=/srv/checker-ko/private-data
# CHECKER_SECRET=<generate a unique random value of at least 32 characters>
# CHECKER_CORS_ORIGINS=https://checker-preprod.internal.example
# CHECKER_COOKIE_SAMESITE=lax
# CHECKER_STORAGE_BACKEND=supabase
# CHECKER_SUPABASE_URL=https://<project-ref>.supabase.co
# CHECKER_SUPABASE_SERVICE_ROLE_KEY=<store-only-in-the-render-secret-manager>
# CHECKER_SUPABASE_STORAGE_BUCKET=checker-private
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0
# DB_POOL_RECYCLE_SECONDS=180
